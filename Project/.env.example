# Codebase Assistant — Docker / local secrets template
# Copy to .env and fill in values (never commit .env):
#   cp .env.example .env

# Required for LLM features (Analysis / Docs / Testing via OpenRouter)
OPENROUTER_API_KEY=

# Optional overrides (Compose sets these to /data/... inside the container)
# CODEBASE_ASSISTANT_DATA_DIR=/data
# CHROMA_PERSIST_DIR=/data/chroma
# MEMORY_STORE_PATH=/data/memory
# RUN_HISTORY_PATH=/data/history/ui_run_history.jsonl
