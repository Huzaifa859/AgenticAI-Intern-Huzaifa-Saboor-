# Virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]

# Testing
.pytest_cache/

# Linting
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# VS Code
.vscode/

# ChromaDB / Codebase Assistant runtime data
# Config defaults: ./.codebase_assistant/chroma and memory_store
.codebase_assistant/
**/.codebase_assistant/
**/chroma_store/
**/.chroma/
**/chroma/
*.sqlite3

# Benchmark run outputs (keep directory via .gitkeep)
Project/benchmarks/results/*
!Project/benchmarks/results/.gitkeep

# Local validation / e2e / bench artifacts (scratch outputs under Project/)
.bench_*/
_bench*/
_e2e*/
_validate*/
_rerun*/

# Environment variables (keep committed templates)
.env
.env.*
!.env.example

# Python packaging
dist/
build/
*.egg-info/

# OS files
.DS_Store
Thumbs.db

# Type checking
.mypy_cache/

# Logs and coverage
*.log
.coverage
htmlcov/
coverage.xml

# MCP / Claude Code local state
.claude/
.mcp.json

# If any part of your MCP server persists data locally
*.db

# If you end up with a JS/TS MCP server or client anywhere
node_modules/
